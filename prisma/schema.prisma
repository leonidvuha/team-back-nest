generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Car {
    id Int @id @default(autoincrement())
    brand String
    model String
    year Int
    price Decimal
    updatedAt DateTime @updatedAt @map("updated_at")
    createdAt DateTime @default(now()) @map("created_at")

    @@map("cars")
}

enum Role {
    USER
    ADMIN
}

model User {
    id String @id @default(uuid(7))
    email String @unique
    password String
    role Role @default(USER)
    updatedAt DateTime @updatedAt @map("updated_at")
    createdAt DateTime @default(now()) @map("created_at")
    @@map("users")
}